{
  "name": "@yitanz/adminjs-ui",
  "version": "0.1.3",
  "description": "WordPress-style Media Library, a visual Settings page and image-upload field widgets for AdminJS 7.",
  "keywords": [
    "adminjs",
    "adminjs-plugin",
    "media-library",
    "upload",
    "image",
    "settings",
    "branding"
  ],
  "type": "module",
  "license": "MIT",
  "author": "yitanz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yitanz/adminjs-ui.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('components','dist/components',{recursive:true})\"",
    "prepublishOnly": "npm run build",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "image-size": "^1.2.1",
    "react-dropzone": "^14.4.1",
    "react-image-crop": "^11.1.2"
  },
  "peerDependencies": {
    "@adminjs/design-system": "^4.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "adminjs": "^7.5.0",
    "express": "^4.18.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reflect-metadata": "^0.2.0",
    "styled-components": "^5.3.0",
    "typeorm": "^0.3.20"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
